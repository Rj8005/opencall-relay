<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenCallRelay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#63b4ff</item>
        <item name="colorPrimaryVariant">#0d1f35</item>
        <item name="colorOnPrimary">#060a10</item>
        <item name="colorSecondary">#1d9e75</item>
        <item name="colorOnSecondary">#060a10</item>
        <item name="android:windowBackground">#060a10</item>
        <item name="android:statusBarColor">#060a10</item>
        <item name="android:navigationBarColor">#060a10</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- TOPO PART B5: every Button() in OfflineCallActivity.kt is a
             plain platform Button — Theme.MaterialComponents' default
             button style force-uppercases its text regardless of the
             Kotlin string literal's own casing (Part A / A6). One theme
             attribute fixes every button in the app at once, rather than
             setting isAllCaps=false at each of the dozens of Button(this)
             call sites individually. -->
        <item name="android:buttonStyle">@style/OcpButtonStyle</item>
    </style>

    <style name="OcpButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
