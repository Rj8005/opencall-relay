<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ambient_rings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION 1 — Status bar row (identical to relay screen)
        ════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:41"
                android:textSize="11sp"
                android:textColor="@color/text_muted"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OCP Network"
                android:textSize="11sp"
                android:textColor="@color/text_muted"/>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION 2 — Header (identical to relay screen)
        ════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/card_bg"
                android:padding="8dp"
                android:scaleType="centerInside"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenCall"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relay Node"
                    android:textSize="10sp"
                    android:textColor="@color/accent_blue"
                    android:letterSpacing="0.08"/>

            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION 3 — Dial display card
        ════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_margin="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_dial_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-light"/>

            <TextView
                android:id="@+id/tv_dial_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to start dialing"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION 4 — Keypad
        ════════════════════════════════════════════════════════════════ -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:useDefaultMargins="false">

            <!-- Row 1 -->

            <LinearLayout
                android:id="@+id/btn_key_1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABC"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEF"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <!-- Row 2 -->

            <LinearLayout
                android:id="@+id/btn_key_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GHI"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JKL"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_6"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MNO"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <!-- Row 3 -->

            <LinearLayout
                android:id="@+id/btn_key_7"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PQRS"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_8"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUV"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_9"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WXYZ"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <!-- Row 4 -->

            <LinearLayout
                android:id="@+id/btn_key_star"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_key_hash"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

        </GridLayout>

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION 5 — Action row (backspace | call | spacer)
        ════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_backspace"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@color/text_secondary"
                android:background="@null"
                android:scaleType="centerInside"
                android:contentDescription="Backspace"/>

            <ImageButton
                android:id="@+id/btn_call"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="32dp"
                android:src="@android:drawable/ic_menu_call"
                android:tint="@color/text_primary"
                android:background="@drawable/btn_primary"
                android:scaleType="centerInside"
                android:stateListAnimator="@null"
                android:contentDescription="Call"/>

            <Space
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:layout_marginStart="32dp"/>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION 6 — Bottom navigation (Dial tab selected)
        ════════════════════════════════════════════════════════════════ -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#08152280"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <!-- Relay -->
            <LinearLayout
                android:id="@+id/nav_relay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:tint="@color/text_muted"
                    android:scaleType="centerInside"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relay"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

            <!-- Dial (selected) -->
            <LinearLayout
                android:id="@+id/nav_dial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_call"
                    android:tint="@color/accent_blue"
                    android:scaleType="centerInside"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dial"
                    android:textSize="9sp"
                    android:textColor="@color/accent_blue"/>

            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:tint="@color/text_muted"
                    android:scaleType="centerInside"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
