<?xml version="1.0" encoding="utf-8"?>
<!--
  Invite panel — shown as a BottomSheetDialogFragment when the user tries to
  call a number that is not yet on OpenCall.  The fragment sets the window
  background to a GradientDrawable with 16 dp top-corner radius so the sheet
  itself does not need a separate drawable file.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="#444444"/>

        <!-- ── Header ──────────────────────────────────────────────────────── -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#FF3B30"
                android:textSize="11sp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tv_invite_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+1 555 000 0000 is not on OpenCall yet"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send them this link — they tap it, browser opens"
            android:textColor="#666666"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="20dp"/>

        <!-- ── Invite URL (readonly) ───────────────────────────────────────── -->

        <EditText
            android:id="@+id/et_invite_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://opencall.net/join/…"
            android:textColor="#BFFF00"
            android:textColorHint="#444444"
            android:textSize="13sp"
            android:background="#111111"
            android:padding="14dp"
            android:inputType="none"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:cursorVisible="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="12dp"/>

        <!-- ── Copy Link (outlined, lime stroke) ──────────────────────────── -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_invite"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Copy Link"
            android:textColor="#BFFF00"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            app:strokeColor="#BFFF00"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@android:color/transparent"
            android:layout_marginBottom="24dp"/>

        <!-- ── "── send directly ──" ──────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="── send directly ──"
            android:textColor="#3A3A3A"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- ── Channel grid — 3 columns ───────────────────────────────────── -->
        <!--
          The fragment clears and repopulates grid_channels based on the server
          response from GET /invite/channels.  The items below are the default
          set shown before the network call returns (or if it fails).
        -->

        <GridLayout
            android:id="@+id/grid_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:useDefaultMargins="false"
            android:layout_marginBottom="24dp">

            <!-- Row 1 ─────────────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMS"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📤"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Row 2 ─────────────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✈️"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telegram"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💜"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Viber"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💚"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LINE"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Row 3 ─────────────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💛"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KakaoTalk"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signal"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉️"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Row 4 ─────────────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call First"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_channel_wechat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="26sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WeChat QR"
                    android:textColor="#BFFF00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </GridLayout>

        <!-- ── WeChat QR panel (hidden until WeChat tapped) ───────────────── -->

        <LinearLayout
            android:id="@+id/ll_qr_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#111111"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WeChat QR Code"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/iv_qr_code"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="fitCenter"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_qr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="Close"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                app:backgroundTint="@android:color/transparent"/>

        </LinearLayout>

        <!-- ── Divider ────────────────────────────────────────────────────── -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#242424"
            android:layout_marginBottom="20dp"/>

        <!-- ── Send SMS automatically (primary CTA, lime green) ───────────── -->

        <Button
            android:id="@+id/btn_auto_sms"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Send SMS automatically"
            android:textColor="#0A0A0A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#BFFF00"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp"/>

        <!-- ── Share via any app (outlined) ──────────────────────────────── -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_any"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Share via any app"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@android:color/transparent"
            android:layout_marginBottom="8dp"/>

        <!-- ── Cancel (text only, centered) ──────────────────────────────── -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:text="Cancel"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            app:rippleColor="#1AFFFFFF"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
