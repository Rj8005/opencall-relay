<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ambient_rings">

    <!-- ═══════════════════════════════════════════════════════════════
         SCREEN A — Setup (shown on first launch only)
    ════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/screen_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- OCP logo -->
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:layout_marginTop="32dp"
                    android:contentDescription="OCP logo"/>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenCall Relay"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="20dp"/>

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relay Node Setup"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="28dp"/>

                <!-- Setup form card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your name"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/et_setup_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/field_bg"
                        android:padding="10dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:inputType="textPersonName"
                        android:singleLine="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your number (with country code)"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/et_setup_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/field_bg"
                        android:padding="10dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:hint="+91 98005 05720"
                        android:textColorHint="@color/text_muted"
                        android:inputType="phone"
                        android:singleLine="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Signal server"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/et_setup_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/field_bg"
                        android:padding="10dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:text="wss://signal.opencall.space"
                        android:inputType="textUri"
                        android:singleLine="true"/>

                </LinearLayout>

                <!-- Set up relay node button -->
                <Button
                    android:id="@+id/btn_setup_complete"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Set up relay node →"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0a0a0a"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"/>

                <!-- OCP address (monospace, small) -->
                <TextView
                    android:id="@+id/tv_setup_ocp_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="monospace"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         SCREEN B — Dashboard (shown after setup)
    ════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/screen_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- ── Header: logo + name·number + "change" ─────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/card_bg"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:contentDescription="OCP logo"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_header_user_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tv_relay_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted"/>

                    <TextView
                        android:id="@+id/tv_relay_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Relay OFF"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_change_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="change"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- ── Scrollable content ─────────────────────────────────── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ── CARD 1: Node status ──────────────────────── -->
                <LinearLayout
                    android:id="@+id/relay_status_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Node status"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:textAllCaps="true"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/tv_status_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STOPPED"
                            android:textSize="9sp"
                            android:textColor="@color/text_muted"
                            android:background="@drawable/btn_primary"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>

                    </LinearLayout>

                    <!-- Stat cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/field_bg"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_calls_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="calls"
                                android:textSize="9sp"
                                android:textColor="@color/text_secondary"
                                android:letterSpacing="0.1"/>

                        </LinearLayout>

                        <Space android:layout_width="8dp" android:layout_height="1dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/field_bg"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_active_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="active"
                                android:textSize="9sp"
                                android:textColor="@color/text_secondary"/>

                        </LinearLayout>

                        <Space android:layout_width="8dp" android:layout_height="1dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/field_bg"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_country"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_blue"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="country"
                                android:textSize="9sp"
                                android:textColor="@color/text_secondary"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Start/Stop relay button -->
                    <Button
                        android:id="@+id/btn_toggle_relay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="Start Relay"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_green"
                        android:background="@drawable/btn_primary"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

                <!-- ── CARD 2: Relay mode ───────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relay mode"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/btn_mode_both"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Calls + SMS"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:background="@drawable/mode_btn_selected"
                            android:textColor="@color/accent_blue"
                            android:clickable="true"
                            android:focusable="true"/>

                        <Space android:layout_width="6dp" android:layout_height="1dp"/>

                        <TextView
                            android:id="@+id/btn_mode_call"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Calls only"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:background="@drawable/mode_btn_normal"
                            android:textColor="@color/text_muted"
                            android:clickable="true"
                            android:focusable="true"/>

                        <Space android:layout_width="6dp" android:layout_height="1dp"/>

                        <TextView
                            android:id="@+id/btn_mode_sms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SMS only"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:background="@drawable/mode_btn_normal"
                            android:textColor="@color/text_muted"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Server"
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/field_bg"
                        android:layout_marginTop="4dp"
                        android:padding="10dp"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/et_server_url"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="wss://your-server"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@null"
                            android:inputType="textUri"
                            android:singleLine="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="edit"
                            android:textSize="9sp"
                            android:textColor="@color/text_muted"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OCP address"
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/field_bg"
                        android:layout_marginTop="4dp"
                        android:padding="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_ocp_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ocp:loading..."
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"
                            android:ellipsize="middle"/>

                        <TextView
                            android:id="@+id/tv_copy_ocp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="copy"
                            android:textSize="9sp"
                            android:textColor="@color/accent_blue"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- ── CARD 3: Credits ──────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/card_bg"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_credits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OCP credits"
                            android:textSize="9sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_credits_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0 today"
                        android:textSize="10sp"
                        android:textColor="@color/accent_green"
                        android:background="@drawable/btn_primary"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ── Bottom navigation ──────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#08152280"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/nav_relay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:tint="@color/accent_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="Relay"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relay"
                    android:textSize="9sp"
                    android:textColor="@color/accent_blue"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_dial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_call"
                    android:tint="@color/text_muted"
                    android:scaleType="centerInside"
                    android:contentDescription="Dial"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dial"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:tint="@color/text_muted"
                    android:scaleType="centerInside"
                    android:contentDescription="Settings"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
