<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#060a10"/>
        </shape>
    </item>

    <item android:gravity="top|start" android:left="-60dp" android:top="-60dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#0f2030"/>
            <size android:width="500dp" android:height="500dp"/>
        </shape>
    </item>

    <item android:gravity="top|start" android:left="-20dp" android:top="-20dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#0d2535"/>
            <size android:width="380dp" android:height="380dp"/>
        </shape>
    </item>

    <item android:gravity="top|start" android:left="20dp" android:top="20dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#0a2030"/>
            <size android:width="280dp" android:height="280dp"/>
        </shape>
    </item>

</layer-list>
